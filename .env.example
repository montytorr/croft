# ---------------------------------------------------------------------------
# Croft — example environment. Copy to .env.local and fill in.
# Never commit a filled-in copy: .env* is gitignored except this file.
# ---------------------------------------------------------------------------

# Public base URL of your Croft instance (also builds password reset links)
CROFT_BASE_URL=http://localhost:3000

# Private PostgreSQL connection used by the app and migration runner.
DATABASE_URL=postgresql://croft_app:password@localhost:5432/croft
# scripts/backup.sh connects as CROFT_DB_USER, which defaults to `postgres` and
# is NOT the role above. Set it to match, or the nightly dump fails on a
# database this URL can reach perfectly well.

DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
AUTH_SESSION_SECONDS=2592000
CROFT_OPERATOR_EMAIL=operator@example.com
CROFT_OPERATOR_PASSWORD=
CROFT_OPERATOR_NAME=

# --- Storage ----------------------------------------------------------------
# Private local storage for task attachments and HMAC key for one-hour links.
CROFT_ATTACHMENT_DIR=/data/attachments
CROFT_ATTACHMENT_SIGNING_KEY=
CROFT_ATTACHMENT_MAX_BYTES=10485760
# Or an S3 bucket instead of the directory, for containers with no persistent
# disk. Credentials come from the platform's role; the app still serves files.
# CROFT_ATTACHMENT_S3_BUCKET=
# CROFT_ATTACHMENT_S3_PREFIX=
# The bucket's region, when the platform sets no AWS_REGION.
# CROFT_ATTACHMENT_S3_REGION=eu-west-3

# --- Email (password reset links) -------------------------------------------
# Password resets are email-only: an administrator can only have a single-use
# link sent to the person, and "Forgot your password?" on the sign-in page sends
# the same link. Sent through Resend (https://resend.com). Unset, the Users page
# disables "Send reset link" and the sign-in page hides the forgot form; the
# break-glass is `node scripts/reset-password.mjs <email>` on the host.
# Links are built from CROFT_BASE_URL (above), never from the request's Host.
# RESEND_API_KEY=
# CROFT_MAIL_FROM=Croft <noreply@croft.example.com>
# CROFT_MAIL_REPLY_TO=

# --- Secrets at rest --------------------------------------------------------
# Seals stored secrets (the Cairn API key) with AES-256-GCM. 32 bytes, as 64
# hex characters or base64: `openssl rand -hex 32`. Unset, a key is derived
# from CROFT_ATTACHMENT_SIGNING_KEY (logged once at start), which ties the two
# together: rotating the signing key would then make stored secrets unreadable.
# Changing this key has the same effect; re-enter the Cairn key in Settings.
CROFT_SECRET_KEY=

# --- Platforms with no one-off tasks (App Runner) ---------------------------
# Apply migrations when the container starts (safe with several at once).
# CROFT_MIGRATE_ON_START=1
# Create the first administrator on start, only while there is none. Remove
# after the first start.
# CROFT_BOOTSTRAP_ADMIN_EMAIL=
# CROFT_BOOTSTRAP_ADMIN_PASSWORD=
# CROFT_BOOTSTRAP_ADMIN_NAME=
# Verified TLS to Amazon RDS: the image carries the CA bundle.
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/rds-global-bundle.pem   (and ?sslmode=verify-full)
# Close live-update streams before a platform request cap (App Runner: 120s).
# CROFT_SSE_MAX_SECONDS=100
# Proxies in front of the app that append to X-Forwarded-For (default 1).
# CROFT_TRUSTED_PROXY_HOPS=1

# --- Deployment (only needed when running behind a reverse proxy) -----------
# The hostname your instance is served on, e.g. croft.example.com
CROFT_DOMAIN=croft.example.com
# External Docker network your reverse proxy already runs on.
CROFT_PROXY_NETWORK=web
CROFT_DATABASE_NETWORK=croft-data

# --- CLI --------------------------------------------------------------------
# Used by the `croft` CLI and by agents. Create a key in Settings -> API keys.
# One key per agent, so writes are attributable and any one can be revoked.
CROFT_API_KEY=
